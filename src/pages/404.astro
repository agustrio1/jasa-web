---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak tersedia.">
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 text-center">
    <p class="font-mono text-sm uppercase tracking-widest text-brick">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-charcoal sm:text-4xl">
      Halaman ini belum kami bangun
    </h1>
    <p class="mt-3 max-w-md text-charcoal/60">
      Sepertinya URL yang Anda tuju tidak ada, atau sudah dipindahkan.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="rounded-full bg-brass px-6 py-3 text-sm font-medium text-ink hover:opacity-90">
        Kembali ke Beranda
      </a>
      <a href="/kontak" class="rounded-full border border-charcoal/20 px-6 py-3 text-sm font-medium text-charcoal hover:border-brick hover:text-brick">
        Hubungi Kami
      </a>
    </div>
  </section>
</Layout>