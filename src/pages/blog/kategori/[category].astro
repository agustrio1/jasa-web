---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import Pagination from '@/components/shared/Pagination.tsx';
import { eq, and, desc, count } from 'drizzle-orm';
import { db } from '@/lib/db';
import { posts, categories } from '@/lib/db/schema/blog';

const PER_PAGE = 9;
const { category: categorySlug } = Astro.params;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const offset = (page - 1) * PER_PAGE;

const category = await db.query.categories.findFirst({
  where: eq(categories.slug, categorySlug!),
});

if (!category) {
  return Astro.redirect('/404');
}

const [items, totalResult] = await Promise.all([
  db.query.posts.findMany({
    where: and(eq(posts.categoryId, category.id), eq(posts.isPublished, true)),
    limit: PER_PAGE,
    offset,
    orderBy: desc(posts.publishedAt),
  }),
  db.select({ value: count() }).from(posts).where(and(eq(posts.categoryId, category.id), eq(posts.isPublished, true))),
]);

const total = totalResult[0]?.value ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={`Kategori: ${category.name}`} description={category.description ?? `Artikel dalam kategori ${category.name}`}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-widest text-brick">Kategori</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-charcoal sm:text-4xl">{category.name}</h1>

    {items.length === 0 ? (
      <p class="mt-10 text-sm text-charcoal/50">Belum ada artikel di kategori ini.</p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((post) => (
          <a href={`/blog/${post.slug}`} class="group">
            {post.coverImage && (
              <img src={post.coverImage} alt={post.title} class="aspect-video w-full rounded-lg object-cover" />
            )}
            <h2 class="mt-3 font-display text-lg font-semibold text-charcoal group-hover:text-brick">{post.title}</h2>
            <p class="mt-1 text-sm text-charcoal/60 line-clamp-2">{post.excerpt}</p>
          </a>
        ))}
      </div>
    )}

    <Pagination client:load page={page} totalPages={totalPages} baseUrl={`/blog/kategori/${category.slug}`} />
  </section>
</Layout>