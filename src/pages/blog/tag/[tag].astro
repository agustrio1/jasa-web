---
import Layout from '@/layouts/Layout.astro';
import Pagination from '@/components/shared/Pagination.tsx';
import { eq, desc, count } from 'drizzle-orm';
import { db } from '@/lib/db';
import { posts, tags, postTags } from '@/lib/db/schema/blog';

const PER_PAGE = 9;
const { tag: tagSlug } = Astro.params;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const offset = (page - 1) * PER_PAGE;

const tag = await db.query.tags.findFirst({ where: eq(tags.slug, tagSlug!) });

if (!tag) {
  return Astro.redirect('/404');
}

const allRelations = await db.query.postTags.findMany({
  where: eq(postTags.tagId, tag.id),
  with: { post: true },
});

const publishedPosts = allRelations
  .map((r) => r.post)
  .filter((p) => p.isPublished)
  .sort((a, b) => {
    const dateA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const dateB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return dateB - dateA;
  });

const total = publishedPosts.length;
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const items = publishedPosts.slice(offset, offset + PER_PAGE);
---

<Layout title={`Tag: ${tag.name}`} description={`Kumpulan artikel dengan tag ${tag.name}`}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-widest text-brick">Tag</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-charcoal sm:text-4xl">#{tag.name}</h1>

    {items.length === 0 ? (
      <p class="mt-10 text-sm text-charcoal/50">Belum ada artikel dengan tag ini.</p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((post) => (
          <a href={`/blog/${post.slug}`} class="group">
            {post.coverImage && (
              <img src={post.coverImage} alt={post.title} class="aspect-video w-full rounded-lg object-cover" />
            )}
            <h2 class="mt-3 font-display text-lg font-semibold text-charcoal group-hover:text-brick">{post.title}</h2>
            <p class="mt-1 text-sm text-charcoal/60 line-clamp-2">{post.excerpt}</p>
          </a>
        ))}
      </div>
    )}

    <Pagination client:load page={page} totalPages={totalPages} baseUrl={`/blog/tag/${tag.slug}`} />
  </section>
</Layout>