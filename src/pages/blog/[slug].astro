---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getPublishedPortfolios } from '@/lib/services/portfolio.service';

const portfolios = await getPublishedPortfolios();

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Portofolio Kami" description="Kumpulan proyek website yang telah kami kerjakan untuk berbagai klien.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-widest text-brick">Portofolio</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Proyek yang telah kami kerjakan</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-charcoal/60 sm:text-base">
      Beberapa website yang sudah kami bangun untuk klien dari berbagai jenis bisnis, mulai dari company profile sampai sistem custom.
    </p>

    {portfolios.length === 0 ? (
      <p class="mt-10 text-sm text-charcoal/50">Belum ada proyek yang ditampilkan.</p>
    ) : (
      <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {portfolios.map((p) => (
          <a href={`/portfolio/${p.slug}`} class="group block">
            {p.coverImage && (
              <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-charcoal/5">
                <img src={p.coverImage} alt={p.title} class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
              </div>
            )}
            <div class="mt-4">
              {p.category && (
                <span class="inline-block rounded-full bg-brick/10 px-3 py-1 font-mono text-xs uppercase tracking-wide text-brick">
                  {p.category}
                </span>
              )}
              <h2 class="mt-2 font-display text-lg font-semibold leading-snug text-charcoal group-hover:text-brick">
                {p.title}
              </h2>
              {p.clientName && <p class="mt-1 text-sm text-charcoal/50">{p.clientName}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>