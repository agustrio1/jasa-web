---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import Pagination from '@/components/shared/Pagination.tsx';
import { eq, and, desc, count, ilike, or } from 'drizzle-orm';
import { db } from '@/lib/db';
import { posts } from '@/lib/db/schema/blog';

const PER_PAGE = 9;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const offset = (page - 1) * PER_PAGE;

const baseCondition = eq(posts.isPublished, true);
const whereCondition = query
  ? and(baseCondition, or(ilike(posts.title, `%${query}%`), ilike(posts.excerpt, `%${query}%`)))
  : baseCondition;

const [items, totalResult] = await Promise.all([
  db.query.posts.findMany({
    where: whereCondition,
    limit: PER_PAGE,
    offset,
    orderBy: desc(posts.publishedAt),
    with: { category: true },
  }),
  db.select({ value: count() }).from(posts).where(whereCondition),
]);

const total = totalResult[0]?.value ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));

const baseUrl = query ? `/blog?q=${encodeURIComponent(query)}` : '/blog';

function formatDate(date: Date | string | null) {
  if (!date) return '';
  return new Date(date).toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Blog" description="Artikel dan tips seputar website, bisnis online, dan digital marketing.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-widest text-brick">Blog</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-charcoal sm:text-4xl">Blog & Artikel</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-charcoal/60 sm:text-base">
      Kumpulan tulisan seputar website, SEO, dan pemasaran digital yang kami rangkum biar bisnis Anda makin gampang berkembang online.
    </p>

    <form method="GET" class="mt-8 flex max-w-md gap-2">
      <input
        type="search"
        name="q"
        value={query}
        placeholder="Cari artikel..."
        class="flex-1 rounded-md border border-charcoal/20 bg-white px-4 py-2 text-sm focus:border-brass focus:outline-none"
      />
      <button type="submit" class="rounded-md bg-charcoal px-4 py-2 text-sm text-bone hover:opacity-90">
        Cari
      </button>
    </form>

    {query && (
      <p class="mt-3 text-sm text-charcoal/50">
        Menampilkan hasil untuk "{query}" ({total} artikel) — <a href="/blog" class="text-brick hover:underline">reset</a>
      </p>
    )}

    {items.length === 0 ? (
      <p class="mt-10 text-sm text-charcoal/50">
        {query ? `Tidak ada artikel yang cocok dengan "${query}".` : 'Belum ada artikel yang dipublikasikan.'}
      </p>
    ) : (
      <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2">
        {items.map((post) => (
          <a href={`/blog/${post.slug}`} class="group block">
            {post.coverImage && (
              <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-charcoal/5">
                <img src={post.coverImage} alt={post.title} class="max-h-full max-w-full object-contain" loading="lazy" />
              </div>
            )}

            {post.category && (
              <span class="mt-4 inline-block font-mono text-xs uppercase tracking-wide text-brick">{post.category.name}</span>
            )}

            <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-charcoal group-hover:text-brick">
              {post.title}
            </h2>

            <p class="mt-2 text-sm leading-relaxed text-charcoal/60 line-clamp-2">{post.excerpt}</p>

            <div class="mt-4 flex items-center gap-2 text-sm text-charcoal/50">
              {post.author && (
                <>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <span>{post.author}</span>
                  <span class="text-charcoal/30">•</span>
                </>
              )}
              <span>{formatDate(post.publishedAt)}</span>
            </div>
          </a>
        ))}
      </div>
    )}

    <Pagination client:load page={page} totalPages={totalPages} baseUrl={baseUrl} />
  </section>
</Layout>