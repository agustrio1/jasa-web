---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Pagination from '@/components/admin/Pagination.tsx';
import {
  getCategoriesPaginated,
  createCategory,
  updateCategory,
  deleteCategory,
  isCategorySlugTaken,
} from '@/lib/services/taxonomy.service';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'create');

  if (intent === 'delete') {
    const id = String(form.get('id'));
    await deleteCategory(id);
    return Astro.redirect('/admin/categories');
  }

  if (intent === 'update') {
    const id = String(form.get('id'));
    const name = String(form.get('name'));
    const slug = String(form.get('slug'));

    if (await isCategorySlugTaken(slug, id)) {
      error = 'Slug sudah dipakai';
    } else {
      await updateCategory(id, name, slug);
      return Astro.redirect('/admin/categories');
    }
  } else {
    const name = String(form.get('name'));
    const slug = String(form.get('slug'));

    if (await isCategorySlugTaken(slug)) {
      error = 'Slug sudah dipakai';
    } else {
      await createCategory(name, slug);
      return Astro.redirect('/admin/categories');
    }
  }
}

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const { items: categories, totalPages, total } = await getCategoriesPaginated(page);
---

<AdminLayout title="Kategori">
  <section class="mx-auto max-w-2xl p-4 sm:p-6">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl">Kategori</h1>
      <span class="text-sm text-gray-500">{total} total</span>
    </div>

    {error && <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-600">{error}</p>}

    <form method="POST" class="mt-6 flex flex-col gap-2 sm:flex-row">
      <input type="hidden" name="intent" value="create" />
      <input name="name" placeholder="Nama kategori" required
        class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm sm:flex-1" />
      <input name="slug" placeholder="slug" required
        class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm sm:flex-1" />
      <button type="submit" class="w-full rounded-md bg-gray-900 px-4 py-2 text-sm text-white sm:w-auto">
        Tambah
      </button>
    </form>

    <ul class="mt-6 divide-y divide-gray-200 rounded-md border border-gray-200">
      {categories.length === 0 && (
        <li class="p-6 text-center text-sm text-gray-400">Belum ada kategori</li>
      )}
      {categories.map((c) => (
        <li class="p-3">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-gray-900">{c.name}</p>
                <p class="truncate text-xs text-gray-400">/{c.slug}</p>
              </div>
              <div class="flex shrink-0 items-center gap-1">
                <span class="rounded-md p-2 text-gray-500 group-open:hidden">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                </span>
                <form method="POST" onsubmit="return confirm('Hapus kategori ini?')">
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="id" value={c.id} />
                  <button type="submit" class="rounded-md p-2 text-red-500 hover:bg-red-50" aria-label="Hapus">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            </summary>

            <form method="POST" class="mt-3 flex flex-col gap-2 sm:flex-row">
              <input type="hidden" name="intent" value="update" />
              <input type="hidden" name="id" value={c.id} />
              <input name="name" value={c.name} required
                class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm sm:flex-1" />
              <input name="slug" value={c.slug} required
                class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm sm:flex-1" />
              <button type="submit" class="w-full rounded-md bg-gray-900 px-4 py-2 text-sm text-white sm:w-auto">
                Simpan
              </button>
            </form>
          </details>
        </li>
      ))}
    </ul>

    <Pagination client:load page={page} totalPages={totalPages} baseUrl="/admin/categories" />
  </section>
</AdminLayout>