---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ServiceForm from '@/components/admin/ServiceForm.tsx';
import { db } from '@/lib/db';
import { services } from '@/lib/db/schema/services';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
const service = await db.query.services.findFirst({
  where: eq(services.id, id!),
  with: { locations: true, packages: true },
});

if (!service) {
  return Astro.redirect('/admin/services');
}
---

<AdminLayout title="Edit Layanan">
  <section class="mx-auto max-w-2xl p-4 sm:p-6">
    <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl">Edit Layanan</h1>
    <div class="mt-6">
      <ServiceForm
        client:load
        initial={{
          id: service.id,
          name: service.name,
          slug: service.slug,
          shortDescription: service.shortDescription ?? '',
          content: service.content,
          icon: service.icon ?? '',
          locations: service.locations.map((l) => ({
            city: l.city,
            slug: l.slug,
            metaTitle: l.metaTitle ?? '',
            metaDescription: l.metaDescription ?? '',
          })),
          packages: service.packages.map((p) => ({
            name: p.name,
            price: p.price,
            priceNote: p.priceNote ?? '',
            features: (p.features as string[]) ?? [],
            isPopular: p.isPopular,
          })),
        }}
      />
    </div>
  </section>
</AdminLayout>