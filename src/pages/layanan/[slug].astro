---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getServiceBySlug, getServiceLocationBySlug } from '@/lib/services/service.service';
import { resolveSeo } from '@/lib/seo/resolve-seo';
import { serviceJsonLd } from '@/lib/seo/json-ld';

const { slug } = Astro.params;

let service = await getServiceBySlug(slug!);
let location = null;

if (!service) {
  location = await getServiceLocationBySlug(slug!);
  service = location?.service ?? null;
}

if (!service) {
  return Astro.redirect('/404');
}

// Ambil deskripsi dasar dari service/location sebagai fallback metadata
const baseDescription = location 
  ? (location.metaDescription || service.shortDescription || '') 
  : (service.shortDescription || '');

const seo = await resolveSeo(location ? 'service_location' : 'service', location?.id ?? service.id, {
  title: location ? (location.metaTitle ?? `${service.name} ${location.city}`) : service.name,
  description: baseDescription,
});

const finalDescription = seo.description || baseDescription;

// Ambil raw data konten teks dari database
const rawContent = location?.contentOverride ?? service.content;

// Ekstraksi teks murni jika data bertipe objek JSON dari Tiptap
let displayText = '';
if (rawContent) {
  if (typeof rawContent === 'string') {
    displayText = rawContent;
  } else if (typeof rawContent === 'object') {
    try {
      // Jika data dibungkus skema Tiptap, bongkar secara rekursif ke teks biasa
      const extractText = (node: any): string => {
        if (!node) return '';
        if (node.text) return node.text;
        if (Array.isArray(node.content)) {
          return node.content.map(extractText).join('');
        }
        if (Array.isArray(node)) {
          return node.map(extractText).join('\n');
        }
        return '';
      };
      displayText = extractText(rawContent) || JSON.stringify(rawContent);
    } catch {
      displayText = JSON.stringify(rawContent);
    }
  }
}

const jsonLd = serviceJsonLd({
  name: location ? `${service.name} ${location.city}` : service.name,
  description: finalDescription,
  url: Astro.url.href,
  areaServed: location?.city,
  providerName: 'Nexaro Studio',
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={seo.title} description={finalDescription} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <h1 class="font-display text-3xl font-semibold text-charcoal sm:text-4xl">
      {location ? `${service.name} ${location.city}` : service.name}
    </h1>
    
    {finalDescription && (
      <p class="mt-4 text-charcoal/60">{finalDescription}</p>
    )}

    {/* RENDER MENGGUNAKAN CSS UTILITY (whitespace-pre-line) */}
    {displayText ? (
      <div class="mt-8 text-sm leading-relaxed text-charcoal/80 whitespace-pre-line sm:text-base">
        {displayText}
      </div>
    ) : (
      <p class="mt-8 text-sm text-charcoal/40 italic">Tidak ada detail konten tambahan untuk layanan ini.</p>
    )}

    {!location && service.locations && service.locations.length > 0 && (
      <div class="mt-10 rounded-lg border border-charcoal/10 bg-white/40 p-6">
        <h2 class="font-display text-lg font-semibold text-charcoal">Tersedia di kota:</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {service.locations.map((loc: any) => (
            <a href={`/layanan/${loc.slug}`} class="rounded-full border border-charcoal/15 bg-white px-4 py-1.5 text-sm text-charcoal/70 hover:border-brick hover:text-brick">
              {loc.city}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>
