---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getServiceBySlug, getServiceLocationBySlug } from '@/lib/services/service.service';
import { getSettings } from '@/lib/services/settings.service';
import { resolveSeo } from '@/lib/seo/resolve-seo';
import { renderRichContent } from '@/lib/tiptap/render';
import { serviceJsonLd, faqJsonLd } from '@/lib/seo/json-ld';

const { slug } = Astro.params;

let service = await getServiceBySlug(slug!);
let location = null;

if (!service) {
  location = await getServiceLocationBySlug(slug!);
  service = location?.service ?? null;
}

if (!service) {
  return Astro.redirect('/404');
}

// Ambil settings untuk link WhatsApp otomatis seperti di index
const settings = await getSettings(['site_name', 'social_whatsapp']);
const siteName = settings.site_name || 'Nexaro Studio';

const baseDescription = location
  ? (location.metaDescription || service.shortDescription || '')
  : (service.shortDescription || '');

const seo = await resolveSeo(location ? 'service_location' : 'service', location?.id ?? service.id, {
  title: location ? (location.metaTitle ?? `${service.name} ${location.city}`) : service.name,
  description: baseDescription,
});

const finalDescription = seo.description || baseDescription;

const contentHtml = renderRichContent(location?.contentOverride ?? service.content);
const packages = (service.packages ?? []).map((pkg: any) => ({
  ...pkg,
  featuresHtml: renderRichContent(pkg.features),
}));
const faqItems = (service.faq as { question: string; answer: string }[]) ?? [];

const jsonLdBlocks: Record<string, unknown>[] = [
  serviceJsonLd({
    name: location ? `${service.name} ${location.city}` : service.name,
    description: finalDescription,
    url: Astro.url.href,
    areaServed: location?.city,
    providerName: 'Nexaro Studio',
  }),
];

if (faqItems.length > 0) {
  jsonLdBlocks.push(faqJsonLd(faqItems));
}

// Helper pembuat link WhatsApp persis seperti di index
function packageWhatsappHref(packageName: string) {
  if (!settings.social_whatsapp) return '/kontak';
  const serviceTitle = location ? `${service?.name} di ${location.city}` : service?.name;
  const message = `Halo ${siteName}, saya tertarik dengan paket ${packageName} untuk layanan ${serviceTitle}. Bisa dijelaskan lebih lanjut?`;
  return `https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`;
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={seo.title} description={finalDescription} jsonLd={jsonLdBlocks}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    {location && (
      <p class="font-mono text-xs uppercase tracking-widest text-brick">Tersedia di {location.city}</p>
    )}
    <h1 class="mt-2 font-display text-3xl font-semibold text-charcoal sm:text-4xl">
      {location ? `${service.name} ${location.city}` : service.name}
    </h1>

    {finalDescription && (
      <p class="mt-4 text-charcoal/60">{finalDescription}</p>
    )}

    {contentHtml ? (
      <div class="prose prose-sm mt-8 max-w-none text-charcoal/80" set:html={contentHtml} />
    ) : (
      <p class="mt-8 text-sm text-charcoal/40 italic">Detail konten tidak tersedia.</p>
    )}

    {/* PERUBAHAN TAMPILAN PAKET: SAMA SEPERTI INDEX */}
    {packages.length > 0 && (
      <div class="mt-16">
        <h2 class="font-display text-2xl font-semibold text-charcoal">Pilihan Paket</h2>
        {/* Menggunakan grid-cols-2 untuk menghindari terlalu sempit karena ada dalam max-w-3xl */}
        <div class="mt-6 grid items-stretch gap-6 sm:grid-cols-2">
          {packages.map((pkg: any) => (
            <div class={`flex h-full flex-col rounded-lg border p-6 ${pkg.isPopular ? 'border-brass bg-ink text-bone' : 'border-charcoal/10 bg-white'}`}>
              {pkg.isPopular && (
                <span class="mb-3 inline-block w-fit rounded-full bg-brass px-3 py-1 text-xs font-medium text-ink">
                  Paling Diminati
                </span>
              )}
              <p class={`font-mono text-xs uppercase tracking-wide ${pkg.isPopular ? 'text-brass' : 'text-brick'}`}>{service.name}</p>
              <h3 class={`mt-1 font-display text-lg font-semibold ${pkg.isPopular ? 'text-bone' : 'text-charcoal'}`}>{pkg.name}</h3>

              <p class={`mt-3 text-xs ${pkg.isPopular ? 'text-bone/50' : 'text-charcoal/40'}`}>Mulai dari</p>
              <p class={`text-2xl font-semibold ${pkg.isPopular ? 'text-brass' : 'text-brick'}`}>
                {pkg.price}
                {pkg.priceNote && <span class={`ml-1 text-sm font-normal ${pkg.isPopular ? 'text-bone/60' : 'text-charcoal/50'}`}>{pkg.priceNote}</span>}
              </p>

              {pkg.featuresHtml && (
                <div
                  class={`prose prose-sm mt-4 max-w-none flex-1 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 ${pkg.isPopular ? 'prose-invert text-bone/80' : 'text-charcoal/70'}`}
                  set:html={pkg.featuresHtml}
                />
              )}

              <a
                href={packageWhatsappHref(pkg.name)}
                target={settings.social_whatsapp ? "_blank" : "_self"}
                rel={settings.social_whatsapp ? "noopener noreferrer" : ""}
                class={`mt-6 block rounded-full px-4 py-2.5 text-center text-sm font-medium ${
                  pkg.isPopular ? 'bg-brass text-ink hover:opacity-90' : 'border border-charcoal/20 text-charcoal hover:border-brick hover:text-brick'
                }`}
              >
                Pesan Sekarang
              </a>
            </div>
          ))}
        </div>
      </div>
    )}

    {faqItems.length > 0 && (
      <div class="mt-16 border-t border-charcoal/10 pt-10">
        <h2 class="font-display text-2xl font-semibold text-charcoal">Pertanyaan Umum</h2>
        <div class="mt-6 space-y-3">
          {faqItems.map((item) => (
            <details class="rounded-lg border border-charcoal/10 bg-white/40 p-4">
              <summary class="cursor-pointer font-medium text-charcoal">{item.question}</summary>
              <p class="mt-2 text-sm text-charcoal/60">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}

    {!location && service.locations && service.locations.length > 0 && (
      <div class="mt-10 rounded-lg border border-charcoal/10 bg-white/40 p-6">
        <h2 class="font-display text-lg font-semibold text-charcoal">Tersedia di kota:</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {service.locations.map((loc: any) => (
            <a href={`/layanan/${loc.slug}`} class="rounded-full border border-charcoal/15 bg-white px-4 py-1.5 text-sm text-charcoal/70 hover:border-brick hover:text-brick">
              {loc.city}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>
