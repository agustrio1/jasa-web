---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getServiceBySlug, getServiceLocationBySlug } from '@/lib/services/service.service';
import { resolveSeo } from '@/lib/seo/resolve-seo';
import { serviceJsonLd } from '@/lib/seo/json-ld';

const { slug } = Astro.params;

let service = await getServiceBySlug(slug!);
let location = null;

if (!service) {
  location = await getServiceLocationBySlug(slug!);
  // Pastikan mengambil relasi service dengan aman
  service = location?.service ?? (location as any)?.services ?? null;
}

if (!service) {
  return Astro.redirect('/404');
}

const baseDescription = location 
  ? (location.metaDescription || service.shortDescription || '') 
  : (service.shortDescription || '');

const seo = await resolveSeo(location ? 'service_location' : 'service', location?.id ?? service.id, {
  title: location ? (location.metaTitle ?? `${service.name} ${location.city}`) : service.name,
  description: baseDescription,
});

const finalDescription = seo.description || baseDescription;

// --- LAYER EXTRAKSI AMAN (Bypass Drizzle Nesting) ---
// 1. Ambil raw data konten dari lokasi atau service utama
let rawContent = location?.contentOverride ?? service.content;

// 2. Jika masih kosong, cek kemungkinan objek Drizzle terbungkus nama tabel (nested select)
if (!rawContent) {
  const deepService = (service as any).services || service;
  const deepLocation = location ? ((location as any).service_locations || location) : null;
  rawContent = deepLocation?.contentOverride ?? deepService?.content;
}

// 3. Konversi ke string HTML murni
let contentHtml = '';
if (rawContent) {
  if (typeof rawContent === 'string') {
    contentHtml = rawContent;
  } else if (typeof rawContent === 'object') {
    // Jaga-jaga jika di DB masih tersimpan bungkus JSON stringify tambahan
    contentHtml = (rawContent as any).html || JSON.stringify(rawContent);
  }
}
// -----------------------------------------------------

const jsonLd = serviceJsonLd({
  name: location ? `${service.name} ${location.city}` : service.name,
  description: finalDescription,
  url: Astro.url.href,
  areaServed: location?.city,
  providerName: 'Nexaro Studio',
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={seo.title} description={finalDescription} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <h1 class="font-display text-3xl font-semibold text-charcoal sm:text-4xl">
      {location ? `${service.name} ${location.city}` : service.name}
    </h1>
    
    {finalDescription && (
      <p class="mt-4 text-charcoal/60">{finalDescription}</p>
    )}

    {/* OUTPUT LAYER */}
    {contentHtml && contentHtml.trim() ? (
      <div class="prose prose-sm mt-8 max-w-none text-charcoal/80" set:html={contentHtml} />
    ) : (
      <div class="mt-8 rounded-md bg-amber-50 p-4 border border-amber-200 text-xs font-mono text-amber-800">
        <p class="font-bold mb-2">⚠️ Debug Log: Data terdeteksi kosong di Server Astro</p>
        <p class="mb-1"><strong>Astro.params.slug:</strong> {slug}</p>
        <p class="mb-1"><strong>Is Location Page?:</strong> {location ? 'Yes' : 'No'}</p>
        <details class="mt-2">
          <summary class="cursor-pointer underline">Lihat isi Dump Object 'service' dari DB</summary>
          <pre class="mt-2 bg-white p-2 border overflow-auto max-h-60">{JSON.stringify(service, null, 2)}</pre>
        </details>
      </div>
    )}

    {!location && service.locations && service.locations.length > 0 && (
      <div class="mt-10 rounded-lg border border-charcoal/10 bg-white/40 p-6">
        <h2 class="font-display text-lg font-semibold text-charcoal">Tersedia di kota:</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {service.locations.map((loc: any) => (
            <a href={`/layanan/${loc.slug}`} class="rounded-full border border-charcoal/15 bg-white px-4 py-1.5 text-sm text-charcoal/70 hover:border-brick hover:text-brick">
              {loc.city}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>
