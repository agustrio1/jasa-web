---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import { getServiceBySlug } from '@/lib/services/service.service';

const { serviceSlug } = Astro.params;
const service = await getServiceBySlug(serviceSlug!);

if (!service) {
  return Astro.redirect('/404');
}
---

<Layout title={service.name} description={service.shortDescription ?? ''}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-semibold text-gray-900">{service.name}</h1>
    <p class="mt-4 text-gray-600">{service.shortDescription}</p>

    {service.locations.length > 0 && (
      <div class="mt-8">
        <h2 class="text-lg font-medium text-gray-900">Tersedia di kota:</h2>
        <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {service.locations.map((loc) => (
            <li>
              <a href={`/layanan/${service.slug}/${loc.slug}`} class="text-blue-600 hover:underline">
                {loc.city}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Layout>