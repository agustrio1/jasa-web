---
import Layout from '@/layouts/Layout.astro';
import { getServiceLocationBySlug } from '@/lib/services/service.service';

const { serviceSlug, city } = Astro.params;
const fullSlug = `${serviceSlug}-${city}`;
const location = await getServiceLocationBySlug(fullSlug);

if (!location) {
  return Astro.redirect('/404');
}

const metaTitle = location.metaTitle ?? `${location.service.name} ${location.city}`;
const metaDescription = location.metaDescription ?? location.service.shortDescription ?? '';
---

<Layout title={metaTitle} description={metaDescription}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-semibold text-gray-900">
      {location.service.name} {location.city}
    </h1>
    <div class="prose mt-6 max-w-none">
      <!-- render location.contentOverride atau fallback ke location.service.content -->
    </div>
  </section>
</Layout>