---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getAllServices, getFeaturedPackages } from '@/lib/services/service.service';
import { getPublishedPosts } from '@/lib/services/post.service';
import { getFeaturedPortfolios, getPublishedPortfolios } from '@/lib/services/portfolio.service';
import { getSettings } from '@/lib/services/settings.service';
import { organizationJsonLd } from '@/lib/seo/json-ld';
import { renderRichContent } from '@/lib/tiptap/render';
import { getFeaturedTestimonials } from '@/lib/services/testimonial.service';

const services = await getAllServices();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const settings = await getSettings([
  'site_name', 'site_default_meta_description', 'social_facebook', 'social_instagram', 'social_whatsapp',
  'homepage_featured_count',
]);

const featuredCount = parseInt(settings.homepage_featured_count, 10) || 3;
const featuredPortfolios = await getFeaturedPortfolios(featuredCount);
const allPortfolios = await getPublishedPortfolios();
const featuredTestimonials = await getFeaturedTestimonials(6);
const showcaseImages = allPortfolios.filter((p) => p.coverImage).slice(0, 6);
const showcaseCol1 = showcaseImages.filter((_, i) => i % 2 === 0);
const showcaseCol2 = showcaseImages.filter((_, i) => i % 2 === 1);

const featuredPackages = await getFeaturedPackages(6);

const siteName = settings.site_name || 'Nexaro Studio';
const siteUrl = Astro.site?.origin ?? Astro.url.origin;

const cities = Array.from(
  new Set(services.flatMap((s) => s.locations?.map((l: any) => l.city) ?? []))
).slice(0, 12);

const jsonLd = organizationJsonLd({
  siteName,
  siteUrl,
  socials: [settings.social_facebook, settings.social_instagram].filter(Boolean),
});

const processSteps = [
  { num: '1.0', title: 'Konsultasi Kebutuhan', desc: 'Kami gali dulu tujuan bisnis Anda, target pengunjung, dan fitur yang benar-benar dibutuhkan — bukan template mentah.' },
  { num: '2.0', title: 'Rancang & Desain', desc: 'Tim kami menyusun tampilan yang mencerminkan brand Anda, dengan struktur SEO-friendly sejak awal.' },
  { num: '3.0', title: 'Bangun & Uji Coba', desc: 'Proses development pakai teknologi modern, dites performa dan keamanannya sebelum diluncurkan.' },
  { num: '4.0', title: 'Serah Terima & Dampingi', desc: 'Website siap tayang, lengkap panduan kelola mandiri lewat CMS yang sudah kami siapkan.' },
];

function packageWhatsappHref(packageName: string, serviceName: string) {
  if (!settings.social_whatsapp) return null;
  const message = `Halo ${siteName}, saya tertarik dengan ${packageName} untuk ${serviceName}. Bisa dijelaskan lebih lanjut?`;
  return `https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`;
}

const whatsappHref = settings.social_whatsapp
  ? `https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Halo ${siteName}, saya ingin konsultasi pembuatan website.`)}`
  : null;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout
  title={`${siteName} — Jasa Pembuatan Website Profesional`}
  description={settings.site_default_meta_description || 'Jasa pembuatan website profesional, cepat, dan teroptimasi SEO untuk bisnis Anda.'}
  jsonLd={jsonLd}
>
  <!-- HERO SECTION: teks kiri, marquee vertikal 2 kolom di kanan -->
  <section class="relative overflow-hidden bg-gradient-to-br from-ink via-ink to-charcoal/90 py-20 text-bone sm:py-28">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05]"
      style="background-image: repeating-linear-gradient(0deg, var(--color-brass) 0px, var(--color-brass) 1px, transparent 1px, transparent 48px), repeating-linear-gradient(90deg, var(--color-brass) 0px, var(--color-brass) 1px, transparent 1px, transparent 48px);"
    ></div>
    <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brass/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-brick/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid items-center gap-12 lg:grid-cols-12">

        <!-- Kolom kiri: teks -->
        <div class="space-y-6 text-left lg:col-span-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-brass/20 bg-brass/5 px-3 py-1">
            <span class="flex h-2 w-2 rounded-full bg-brass animate-pulse"></span>
            <p class="font-mono text-[10px] uppercase tracking-wider text-brass font-medium">Jasa Pembuatan Website Premium</p>
          </div>

          <h1 class="font-display text-4xl font-extrabold leading-[1.15] text-white sm:text-5xl">
            Bukan Sekadar Website,<br />
            <span class="text-brass">Tapi Mesin Pertumbuhan Bisnis.</span>
          </h1>

          <p class="max-w-xl text-base leading-relaxed text-bone/80 sm:text-lg">
            Kami membangun website premium berkecepatan tinggi yang dirancang khusus untuk membangun kredibilitas, mendominasi halaman pencarian Google SEO, serta mengonversi pengunjung kasual menjadi pembeli loyal bisnis Anda.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a href="#harga" class="inline-flex items-center justify-center rounded-xl bg-brass px-8 py-4 text-sm font-semibold text-ink shadow-lg shadow-brass/10 transition-transform hover:-translate-y-0.5 hover:opacity-95">
              Lihat Paket Harga
            </a>
            {whatsappHref && (
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl border border-bone/20 bg-white/5 px-8 py-4 text-sm font-semibold text-bone backdrop-blur-sm transition-all hover:border-brass hover:text-brass hover:bg-white/10">
                <svg class="mr-2 h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.713-1.457L0 24zm6.59-4.846c1.6.95 3.488 1.449 5.412 1.451 5.428 0 9.846-4.415 9.849-9.847a9.77 9.77 0 0 0-2.868-6.963 9.8 9.8 0 0 0-6.964-2.864c-5.43 0-9.85 4.415-9.852 9.849-.001 1.925.501 3.808 1.454 5.409l-.951 3.474 3.562-.934zm11.205-5.385c-.372-.188-2.202-1.086-2.543-1.21-.343-.124-.593-.188-.843.188-.25.374-.967 1.21-1.184 1.459-.219.248-.438.277-.81.09-3.623-1.814-5.024-3.097-6.233-5.174-.313-.537.313-.497.896-1.656.093-.19.047-.355-.023-.497-.072-.143-.593-1.428-.813-1.957-.214-.514-.448-.444-.619-.453-.16-.008-.343-.01-.527-.01-.184 0-.485.069-.739.347-.253.277-.967.944-.967 2.301 0 1.356.987 2.668 1.123 2.852.137.184 1.943 2.967 4.707 4.16.657.284 1.17.453 1.57.58.66.21 1.26.18 1.734.11.53-.08 1.63-.667 1.86-1.282.23-.615.23-1.142.16-1.252-.07-.11-.253-.188-.626-.376z"/>
                </svg>
                Konsultasi Gratis
              </a>
            )}
          </div>
        </div>

        <!-- Kolom kanan: marquee vertikal 2 kolom, gambar utuh tidak kepotong -->
        {showcaseImages.length > 0 && (
          <div class="relative hidden h-[520px] overflow-hidden lg:col-span-6 lg:grid lg:grid-cols-2 lg:gap-4">
            <div class="flex flex-col gap-4 animate-[marqueeUp_28s_linear_infinite]">
              {[...showcaseCol1, ...showcaseCol1].map((p) => (
                <a href={`/portfolio/${p.slug}`} class="block overflow-hidden rounded-xl border border-bone/10 bg-charcoal shadow-lg shadow-black/30">
                  <img src={p.coverImage!} alt={p.title} class="w-full object-contain" loading="lazy" />
                </a>
              ))}
            </div>
            <div class="flex flex-col gap-4 animate-[marqueeDown_28s_linear_infinite] pt-16">
              {[...showcaseCol2, ...showcaseCol2].map((p) => (
                <a href={`/portfolio/${p.slug}`} class="block overflow-hidden rounded-xl border border-bone/10 bg-charcoal shadow-lg shadow-black/30">
                  <img src={p.coverImage!} alt={p.title} class="w-full object-contain" loading="lazy" />
                </a>
              ))}
            </div>
            <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-ink to-transparent"></div>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ink to-transparent"></div>
          </div>
        )}

      </div>
    </div>
  </section>

  {services.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Layanan</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Yang bisa kami bangun untuk Anda</h2>
        </div>
        <a href="/layanan" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 6).map((s) => (
          <a href={`/layanan/${s.slug}`} class="group rounded-lg border border-charcoal/10 bg-white/40 p-6 transition-all hover:-translate-y-1 hover:border-brick/40 hover:shadow-lg hover:shadow-charcoal/5">
            <h3 class="font-display text-lg font-semibold text-charcoal group-hover:text-brick">{s.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/60">{s.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-charcoal/5 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Cara Kami Bekerja</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Proses yang teruji, dari konsultasi hingga online</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step) => (
          <div class="relative rounded-lg border border-charcoal/10 bg-white p-6 transition-shadow hover:shadow-md">
            <span class="font-mono text-2xl font-bold text-brick/25">{step.num}</span>
            <h3 class="mt-3 font-display text-base font-semibold text-charcoal">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/60">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {featuredPackages.length > 0 && (
    <section id="harga" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Harga</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Pilih paket sesuai kebutuhan bisnis Anda</h2>
      </div>

      <div class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredPackages.map((pkg: any) => (
          <div class={`flex h-full flex-col rounded-lg border p-6 transition-all hover:-translate-y-1 hover:shadow-xl ${pkg.isPopular ? 'border-brass bg-ink text-bone shadow-lg shadow-brass/10' : 'border-charcoal/10 bg-white'}`}>
            {pkg.isPopular && (
              <span class="mb-3 inline-block w-fit rounded-full bg-brass px-3 py-1 text-xs font-medium text-ink">
                Paling Diminati
              </span>
            )}
            <p class={`font-mono text-xs uppercase tracking-wide ${pkg.isPopular ? 'text-brass' : 'text-brick'}`}>{pkg.serviceName}</p>
            <h3 class={`mt-1 font-display text-lg font-semibold ${pkg.isPopular ? 'text-bone' : 'text-charcoal'}`}>{pkg.name}</h3>

            <p class={`mt-3 text-xs ${pkg.isPopular ? 'text-bone/50' : 'text-charcoal/40'}`}>Mulai dari</p>
            <p class={`text-2xl font-semibold ${pkg.isPopular ? 'text-brass' : 'text-brick'}`}>
              {pkg.price}
              {pkg.priceNote && <span class={`ml-1 text-sm font-normal ${pkg.isPopular ? 'text-bone/60' : 'text-charcoal/50'}`}>{pkg.priceNote}</span>}
            </p>

            {renderRichContent(pkg.features) && (
              <div
                class={`prose prose-sm mt-4 max-w-none flex-1 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 ${pkg.isPopular ? 'prose-invert text-bone/80' : 'text-charcoal/70'}`}
                set:html={renderRichContent(pkg.features)}
              />
            )}

            {packageWhatsappHref(pkg.name, pkg.serviceName) && (
              <a
                href={packageWhatsappHref(pkg.name, pkg.serviceName)!}
                target="_blank"
                rel="noopener noreferrer"
                class={`mt-6 block rounded-full px-4 py-2.5 text-center text-sm font-medium transition-opacity ${
                  pkg.isPopular ? 'bg-brass text-ink hover:opacity-90' : 'border border-charcoal/20 text-charcoal hover:border-brick hover:text-brick'
                }`}
              >
                Pesan Sekarang
              </a>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {featuredPortfolios.length > 0 && (
    <section class="bg-charcoal/5 py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-10 flex items-end justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-brick">Portofolio</p>
            <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Karya terbaik kami</h2>
          </div>
          <a href="/portfolio" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua →</a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredPortfolios.map((p) => (
            <a href={`/portfolio/${p.slug}`} class="group overflow-hidden rounded-lg border border-charcoal/10 bg-white transition-all hover:-translate-y-1 hover:shadow-lg">
              {p.coverImage && (
                <img src={p.coverImage} alt={p.title} class="aspect-video w-full object-cover" loading="lazy" />
              )}
              <div class="p-5">
                {p.category && <span class="font-mono text-xs uppercase tracking-wide text-brick">{p.category}</span>}
                <h3 class="mt-1 font-display text-base font-semibold text-charcoal group-hover:text-brick">{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  
  {latestPosts.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Blog</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Strategi website untuk bisnis</h2>
        </div>
        <a href="/blog" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group">
            {post.coverImage && (
              <img src={post.coverImage} alt={post.title} class="aspect-video w-full rounded-lg object-cover transition-opacity group-hover:opacity-90" loading="lazy" />
            )}
            <h3 class="mt-3 font-display text-base font-semibold text-charcoal group-hover:text-brick">{post.title}</h3>
            <p class="mt-1 text-sm text-charcoal/60 line-clamp-2">{post.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  
  {featuredTestimonials.length > 0 && (
    <section class="py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto mb-14 max-w-2xl text-center">
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Testimoni</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Apa kata klien kami</h2>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredTestimonials.map((t) => (
            <div class="relative rounded-lg border border-charcoal/10 bg-white p-6">
              <span class="pointer-events-none absolute right-4 top-2 font-display text-5xl leading-none text-brick/10">"</span>
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 ${i < t.rating ? 'text-brass' : 'text-charcoal/10'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                  </svg>
                ))}
              </div>
              <p class="relative mt-4 text-sm leading-relaxed text-charcoal/70">{t.quote}</p>
              <div class="mt-4 flex items-center gap-3">
                {t.avatar && <img src={t.avatar} alt={t.name} class="h-10 w-10 rounded-full object-cover" />}
                <div>
                  <p class="text-sm font-semibold text-charcoal">{t.name}</p>
                  {(t.role || t.company) && (
                    <p class="text-xs text-charcoal/50">{[t.role, t.company].filter(Boolean).join(', ')}</p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-brick">FAQ</p>
      <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Pertanyaan yang sering ditanyakan</h2>
    </div>

    <div class="space-y-3">
      {[
        { q: 'Berapa lama proses pembuatan website?', a: 'Tergantung skala paket, umumnya 3–30 hari kerja sejak kebutuhan disepakati dan materi (logo, teks, gambar) sudah kami terima.' },
        { q: 'Apakah harga sudah termasuk domain dan hosting?', a: 'Tergantung paket yang dipilih — sebagian paket sudah termasuk domain dan hosting tahun pertama, detail lengkap ada di halaman tiap layanan.' },
        { q: 'Apakah saya bisa mengelola konten sendiri setelah website jadi?', a: 'Bisa. Setiap website dilengkapi CMS admin yang mudah dipakai untuk update layanan, blog, dan media tanpa perlu coding.' },
        { q: 'Apakah ada revisi setelah desain awal?', a: 'Ada, jumlah revisi mengikuti ketentuan paket yang dipilih. Detail bisa didiskusikan saat konsultasi.' },
        { q: 'Bagaimana kalau lokasi bisnis saya di luar kota yang tercantum?', a: 'Tetap bisa — proses kerja kami sepenuhnya online, jadi lokasi bisnis di mana pun tidak jadi kendala.' },
      ].map((item) => (
        <details class="group rounded-lg border border-charcoal/10 bg-white/40 p-4 transition-colors open:border-brick/30">
          <summary class="cursor-pointer list-none font-medium text-charcoal marker:content-none">
            <span class="flex items-center justify-between">
              {item.q}
              <span class="ml-4 text-brick transition-transform group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-2 text-sm text-charcoal/60">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-brick py-16 text-bone">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-3xl font-semibold">Siap punya website sendiri?</h2>
      <p class="mt-3 text-bone/80">Ceritakan kebutuhan bisnis Anda, kami bantu wujudkan dalam bentuk website.</p>

      {whatsappHref && (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block rounded-full bg-bone px-8 py-3 text-sm font-medium text-brick hover:opacity-90">
          Mulai Konsultasi
        </a>
      )}

      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-bone/60">
        Gratis Domain • Gratis Hosting • Gratis SSL • Gratis Maintenance
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes marqueeUp {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }
  @keyframes marqueeDown {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }
</style>