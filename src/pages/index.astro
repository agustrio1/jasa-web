---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getAllServices } from '@/lib/services/service.service';
import { getPublishedPosts } from '@/lib/services/post.service';
import { getFeaturedPortfolios } from '@/lib/services/portfolio.service';
import { getSettings } from '@/lib/services/settings.service';
import { organizationJsonLd } from '@/lib/seo/json-ld';

const services = await getAllServices();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const settings = await getSettings([
  'site_name', 'site_default_meta_description', 'social_facebook', 'social_instagram', 'social_whatsapp',
  'homepage_featured_count',
]);

const featuredCount = parseInt(settings.homepage_featured_count, 10) || 3;
const featuredPortfolios = await getFeaturedPortfolios(featuredCount);

const siteName = settings.site_name || 'Nexaro Studio';
const siteUrl = Astro.site?.origin ?? Astro.url.origin;

const cities = Array.from(
  new Set(services.flatMap((s) => s.locations?.map((l: any) => l.city) ?? []))
).slice(0, 12);

const exampleSlugs = services
  .flatMap((s) => s.locations?.slice(0, 1).map((l: any) => l.slug) ?? [])
  .slice(0, 4);

const jsonLd = organizationJsonLd({
  siteName,
  siteUrl,
  socials: [settings.social_facebook, settings.social_instagram].filter(Boolean),
});

// Referensi Nilai Jual Utama (Dari Analisis JasaWeb & Nuhaweb)
const features = [
  { title: 'Desain Mobile & SEO Friendly', desc: 'Website otomatis responsif di HP dan teroptimasi untuk bersaing di Google.' },
  { title: 'Proses Cepat & Praktis', desc: 'Terima beres, website siap tayang lengkap dengan CMS yang mudah dikelola.' },
  { title: 'Garansi & Support Handal', desc: 'Dukungan teknis berkala dan garansi perbaikan jika terjadi kendala sistem.' },
];

const steps = [
  { num: '01', title: 'Pilih Layanan & Konsultasi', desc: 'Diskusikan kebutuhan bisnis Anda dan tentukan skala website yang diinginkan.' },
  { num: '02', title: 'Proses Desain & Development', desc: 'Tim ahli kami merancang arsitektur web yang cepat, aman, dan estetik.' },
  { num: '03', title: 'Website Siap Serah Terima', desc: 'Website diluncurkan, lengkap dengan panduan kelola mandiri.' },
];

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout
  title={`${siteName} — Jasa Pembuatan Website Profesional & Terpercaya`}
  description={settings.site_default_meta_description || 'Jasa pembuatan website profesional untuk bisnis, UMKM, dan korporasi.'}
  jsonLd={jsonLd}
>
  {/* HERO SECTION */}
  <section class="relative overflow-hidden bg-ink py-24 text-bone sm:py-32">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: repeating-linear-gradient(0deg, var(--color-brass) 0px, var(--color-brass) 1px, transparent 1px, transparent 48px), repeating-linear-gradient(90deg, var(--color-brass) 0px, var(--color-brass) 1px, transparent 1px, transparent 48px);"
    ></div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-brass">Professional Website Developer</p>

      <h1 class="mt-6 font-display text-4xl font-semibold leading-tight sm:text-6xl">
        Bukan Sekadar Website,<br class="hidden sm:block" /> Tapi Mesin Pertumbuhan Bisnis.
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-base text-bone/70 sm:text-lg">
        Kami membangun website premium yang dirancang khusus untuk membangun kredibilitas, meningkatkan visibilitas di Google SEO, dan mengonversi pengunjung menjadi pembeli.
      </p>

      {exampleSlugs.length > 0 && (
        <div class="mx-auto mt-8 max-w-md rounded-lg border border-brass/30 bg-black/20 px-4 py-3 text-left font-mono text-xs text-brass/90 sm:text-sm">
          <span class="text-bone/40">{siteUrl}/layanan/</span><span id="typewriter"></span><span class="animate-pulse">|</span>
        </div>
      )}

      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/layanan" class="rounded-full bg-brass px-6 py-3 text-sm font-medium text-ink hover:opacity-90 transition-opacity">
          Lihat Paket Website
        </a>
        {settings.social_whatsapp && (
          <a
            href={`https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}?text=Halo%20${encodeURIComponent(siteName)},%20saya%20ingin%20konsultasi%20website.`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-bone/30 px-6 py-3 text-sm font-medium text-bone hover:border-brass hover:text-brass transition-colors"
          >
            Konsultasi via WhatsApp Gratis
          </a>
        )}
      </div>
    </div>
  </section>

  {/* NEW SECTION: WHY CHOOSE US (Preferensi Nuhaweb/JasaWeb) */}
  <section class="bg-white py-20 border-b border-charcoal/5">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Keunggulan</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Mengapa Mempercayakan Website Anda Kepada Kami?</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3">
        {features.map((f) => (
          <div class="p-6 rounded-xl border border-charcoal/10 bg-charcoal/[0.02] hover:bg-white hover:shadow-lg transition-all duration-300">
            <h3 class="font-display text-lg font-semibold text-charcoal">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-charcoal/60">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SERVICES SECTION */}
  {services.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Solusi Kami</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Layanan Pembuatan Website</h2>
        </div>
        <a href="/layanan" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua layanan →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 6).map((s) => (
          <a
            href={`/layanan/${s.slug}`}
            class="group rounded-lg border border-charcoal/10 bg-white p-6 transition-all shadow-sm hover:shadow-md hover:border-brick/40"
          >
            <h3 class="font-display text-lg font-semibold text-charcoal group-hover:text-brick">{s.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/60">{s.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* NEW SECTION: HOW IT WORKS (3 Langkah Mudah dari JasaWeb) */}
  <section class="bg-charcoal/5 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Alur Kerja</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">3 Langkah Mudah Memiliki Website</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3 relative">
        {steps.map((st) => (
          <div class="relative bg-white p-8 rounded-xl border border-charcoal/10">
            <span class="font-display text-4xl font-bold text-brick/20 absolute top-4 right-6">{st.num}</span>
            <h3 class="font-display text-lg font-semibold text-charcoal mt-2">{st.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-charcoal/60">{st.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* PORTFOLIO SECTION */}
  {featuredPortfolios.length > 0 && (
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-10 flex items-end justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-brick">Portofolio</p>
            <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Hasil Kerja Terbaru</h2>
          </div>
          <a href="/portfolio" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua karya →</a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredPortfolios.map((p) => (
            <a href={`/portfolio/${p.slug}`} class="group overflow-hidden rounded-lg border border-charcoal/10 bg-white transition-transform hover:-translate-y-1">
              {p.coverImage && (
                <img src={p.coverImage} alt={p.title} class="aspect-video w-full object-cover" loading="lazy" />
              )}
              <div class="p-5">
                {p.category && (
                  <span class="font-mono text-xs uppercase tracking-wide text-brick">{p.category}</span>
                )}
                <h3 class="mt-1 font-display text-base font-semibold text-charcoal group-hover:text-brick">{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* LOCATION/SEO SCOPE */}
  {cities.length > 0 && (
    <section class="py-16 bg-charcoal/[0.02] border-t border-charcoal/5">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Jangkauan Layanan</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-charcoal">Melayani Pembuatan Website di Berbagai Kota</h2>

        <div class="mt-6 flex flex-wrap gap-2">
          {cities.map((city) => (
            <span class="rounded-full border border-charcoal/15 bg-white px-4 py-1.5 text-sm text-charcoal/70">
              Jasa Web {city}
            </span>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* BLOG SECTION */}
  {latestPosts.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Edukasi & Blog</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Wawasan Terbaru Seputar Website & Bisnis</h2>
        </div>
        <a href="/blog" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua artikel →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group">
            {post.coverImage && (
              <img src={post.coverImage} alt={post.title} class="aspect-video w-full rounded-lg object-cover" loading="lazy" />
            )}
            <h3 class="mt-3 font-display text-base font-semibold text-charcoal group-hover:text-brick">{post.title}</h3>
            <p class="mt-1 text-sm text-charcoal/60 line-clamp-2">{post.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* CTA BOTTOM */}
  <section class="bg-brick py-20 text-bone text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="font-display text-3xl font-semibold sm:text-4xl">Siap Mengonlinekan Bisnis Anda dengan Tepat?</h2>
      <p class="mt-4 text-bone/80 max-w-xl mx-auto text-base">Konsultasikan konsep bisnis Anda sekarang. Konsultasi 100% gratis bersama IT Consultant kami.</p>

      {settings.social_whatsapp && (
        <a
          href={`https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}?text=Halo%20${encodeURIComponent(siteName)},%20saya%20tertarik%20membuat%20website.`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-block rounded-full bg-bone px-8 py-3.5 text-sm font-medium text-brick hover:bg-brass hover:text-ink transition-colors shadow-lg"
        >
          Hubungi Kami via WhatsApp Sekarang
        </a>
      )}
    </div>
  </section>
</Layout>

<script define:vars={{ exampleSlugs }}>
  const el = document.getElementById('typewriter');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && exampleSlugs.length > 0 && !prefersReducedMotion) {
    let slugIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const current = exampleSlugs[slugIndex];

      if (!deleting) {
        charIndex++;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(tick, 1400);
          return;
        }
      } else {
        charIndex--;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          slugIndex = (slugIndex + 1) % exampleSlugs.length;
        }
      }

      setTimeout(tick, deleting ? 30 : 60);
    }

    tick();
  } else if (el && exampleSlugs.length > 0) {
    el.textContent = exampleSlugs[0];
  }
</script>
