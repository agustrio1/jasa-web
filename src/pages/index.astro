---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getAllServices, getFeaturedPackages } from '@/lib/services/service.service';
import { getPublishedPosts } from '@/lib/services/post.service';
import { getFeaturedPortfolios, getPublishedPortfolios } from '@/lib/services/portfolio.service';
import { getSettings } from '@/lib/services/settings.service';
import { organizationJsonLd } from '@/lib/seo/json-ld';

const services = await getAllServices();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const settings = await getSettings([
  'site_name', 'site_default_meta_description', 'social_facebook', 'social_instagram', 'social_whatsapp',
  'homepage_featured_count',
]);

const featuredCount = parseInt(settings.homepage_featured_count, 10) || 3;
const featuredPortfolios = await getFeaturedPortfolios(featuredCount);
const allPortfolios = await getPublishedPortfolios();
const showcaseImages = allPortfolios.filter((p) => p.coverImage).slice(0, 10);

const featuredPackages = await getFeaturedPackages(6);

const siteName = settings.site_name || 'Nexaro Studio';
const siteUrl = Astro.site?.origin ?? Astro.url.origin;

const cities = Array.from(
  new Set(services.flatMap((s) => s.locations?.map((l: any) => l.city) ?? []))
).slice(0, 12);

const exampleSlugs = services
  .flatMap((s) => s.locations?.slice(0, 1).map((l: any) => l.slug) ?? [])
  .slice(0, 4);

const jsonLd = organizationJsonLd({
  siteName,
  siteUrl,
  socials: [settings.social_facebook, settings.social_instagram].filter(Boolean),
});

const processSteps = [
  { num: '01', title: 'Konsultasi Kebutuhan', desc: 'Kami gali dulu tujuan bisnis Anda, target pengunjung, dan fitur yang benar-benar dibutuhkan — bukan template mentah.' },
  { num: '02', title: 'Rancang & Desain', desc: 'Tim kami menyusun tampilan yang mencerminkan brand Anda, dengan struktur SEO-friendly sejak awal.' },
  { num: '03', title: 'Bangun & Uji Coba', desc: 'Proses development pakai teknologi modern, dites performa dan keamanannya sebelum diluncurkan.' },
  { num: '04', title: 'Serah Terima & Dampingi', desc: 'Website siap tayang, lengkap panduan kelola mandiri lewat CMS yang sudah kami siapkan.' },
];

const whatsappHref = settings.social_whatsapp
  ? `https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Halo ${siteName}, saya ingin konsultasi pembuatan website.`)}`
  : null;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout
  title={`${siteName} — Jasa Pembuatan Website Profesional`}
  description={settings.site_default_meta_description || 'Jasa pembuatan website profesional, cepat, dan teroptimasi SEO untuk bisnis Anda.'}
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden bg-ink py-24 text-bone sm:py-32">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: repeating-linear-gradient(0deg, var(--color-brass) 0px, var(--color-brass) 1px, transparent 1px, transparent 48px), repeating-linear-gradient(90deg, var(--color-brass) 0px, var(--color-brass) 1px, transparent 1px, transparent 48px);"
    ></div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-brass">Jasa Pembuatan Website</p>

      <h1 class="mt-6 font-display text-4xl font-semibold leading-tight sm:text-6xl">
        Bukan Sekadar Website,<br class="hidden sm:block" /> Tapi Mesin Pertumbuhan Bisnis.
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-base text-bone/70 sm:text-lg">
        Kami membangun website premium yang dirancang khusus untuk membangun kredibilitas, meningkatkan visibilitas di Google SEO, dan mengonversi pengunjung menjadi pembeli.
      </p>

      {exampleSlugs.length > 0 && (
        <div class="mx-auto mt-8 max-w-md rounded-lg border border-brass/30 bg-black/20 px-4 py-3 text-left font-mono text-xs text-brass/90 sm:text-sm">
          <span class="text-bone/40">{siteUrl}/layanan/</span><span id="typewriter"></span><span class="animate-pulse">|</span>
        </div>
      )}

      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="#harga" class="rounded-full bg-brass px-6 py-3 text-sm font-medium text-ink hover:opacity-90">
          Lihat Paket Harga
        </a>
        {whatsappHref && (
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="rounded-full border border-bone/30 px-6 py-3 text-sm font-medium text-bone hover:border-brass hover:text-brass">
            Konsultasi Gratis
          </a>
        )}
      </div>
    </div>
  </section>

  {showcaseImages.length > 0 && (
    <section class="overflow-hidden border-b border-charcoal/10 bg-white py-8">
      <div class="flex animate-[scroll_40s_linear_infinite] gap-4">
        {[...showcaseImages, ...showcaseImages].map((p) => (
          <a href={`/portfolio/${p.slug}`} class="w-56 shrink-0 overflow-hidden rounded-lg border border-charcoal/10">
            <img src={p.coverImage!} alt={p.title} class="aspect-video w-full object-cover" loading="lazy" />
          </a>
        ))}
      </div>
    </section>
  )}

  {services.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Layanan</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Yang bisa kami bangun untuk Anda</h2>
        </div>
        <a href="/layanan" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 6).map((s) => (
          <a href={`/layanan/${s.slug}`} class="group rounded-lg border border-charcoal/10 bg-white/40 p-6 transition-colors hover:border-brick/40">
            <h3 class="font-display text-lg font-semibold text-charcoal group-hover:text-brick">{s.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/60">{s.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-charcoal/5 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Alur Kerja</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Prosesnya jelas, dari awal sampai selesai</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step) => (
          <div class="relative rounded-lg border border-charcoal/10 bg-white p-6">
            <span class="font-display text-3xl font-bold text-brick/20">{step.num}</span>
            <h3 class="mt-3 font-display text-base font-semibold text-charcoal">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/60">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {featuredPackages.length > 0 && (
    <section id="harga" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Harga</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Pilih paket sesuai kebutuhan bisnis Anda</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredPackages.map((pkg: any) => (
          <div class={`relative rounded-lg border p-6 ${pkg.isPopular ? 'border-brass bg-ink text-bone' : 'border-charcoal/10 bg-white'}`}>
            {pkg.isPopular && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brass px-3 py-1 text-xs font-medium text-ink">
                Paling Diminati
              </span>
            )}
            <p class={`font-mono text-xs uppercase tracking-wide ${pkg.isPopular ? 'text-brass' : 'text-brick'}`}>{pkg.serviceName}</p>
            <h3 class={`mt-1 font-display text-lg font-semibold ${pkg.isPopular ? 'text-bone' : 'text-charcoal'}`}>{pkg.name}</h3>
            <p class={`mt-3 text-2xl font-semibold ${pkg.isPopular ? 'text-brass' : 'text-brick'}`}>
              {pkg.price}
              {pkg.priceNote && <span class={`ml-1 text-sm font-normal ${pkg.isPopular ? 'text-bone/60' : 'text-charcoal/50'}`}>{pkg.priceNote}</span>}
            </p>

            {pkg.features && (pkg.features as string[]).length > 0 && (
              <ul class="mt-4 space-y-2">
                {(pkg.features as string[]).slice(0, 6).map((feature) => (
                  <li class={`flex items-start gap-2 text-sm ${pkg.isPopular ? 'text-bone/80' : 'text-charcoal/70'}`}>
                    <svg xmlns="http://www.w3.org/2000/svg" class={`mt-0.5 h-4 w-4 shrink-0 ${pkg.isPopular ? 'text-brass' : 'text-brick'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            )}

            <a
              href={`/layanan/${pkg.serviceSlug}`}
              class={`mt-6 block rounded-full px-4 py-2.5 text-center text-sm font-medium ${
                pkg.isPopular ? 'bg-brass text-ink hover:opacity-90' : 'border border-charcoal/20 text-charcoal hover:border-brick hover:text-brick'
              }`}
            >
              Lihat Detail
            </a>
          </div>
        ))}
      </div>
    </section>
  )}

  {featuredPortfolios.length > 0 && (
    <section class="bg-charcoal/5 py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-10 flex items-end justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-brick">Portofolio</p>
            <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Proyek unggulan</h2>
          </div>
          <a href="/portfolio" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua →</a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredPortfolios.map((p) => (
            <a href={`/portfolio/${p.slug}`} class="group overflow-hidden rounded-lg border border-charcoal/10 bg-white">
              {p.coverImage && (
                <img src={p.coverImage} alt={p.title} class="aspect-video w-full object-cover" loading="lazy" />
              )}
              <div class="p-5">
                {p.category && <span class="font-mono text-xs uppercase tracking-wide text-brick">{p.category}</span>}
                <h3 class="mt-1 font-display text-base font-semibold text-charcoal group-hover:text-brick">{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {cities.length > 0 && (
    <section class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Jangkauan</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-charcoal">Kota yang kami layani</h2>

        <div class="mt-6 flex flex-wrap gap-2">
          {cities.map((city) => (
            <span class="rounded-full border border-charcoal/15 bg-white px-4 py-1.5 text-sm text-charcoal/70">{city}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brick">Blog</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Tulisan terbaru</h2>
        </div>
        <a href="/blog" class="hidden text-sm font-medium text-brick hover:underline sm:inline">Lihat semua →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group">
            {post.coverImage && (
              <img src={post.coverImage} alt={post.title} class="aspect-video w-full rounded-lg object-cover" loading="lazy" />
            )}
            <h3 class="mt-3 font-display text-base font-semibold text-charcoal group-hover:text-brick">{post.title}</h3>
            <p class="mt-1 text-sm text-charcoal/60 line-clamp-2">{post.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-brick">FAQ</p>
      <h2 class="mt-2 font-display text-3xl font-semibold text-charcoal">Pertanyaan yang sering ditanyakan</h2>
    </div>

    <div class="space-y-3">
      {[
        { q: 'Berapa lama proses pembuatan website?', a: 'Tergantung skala paket, umumnya 3–30 hari kerja sejak kebutuhan disepakati dan materi (logo, teks, gambar) sudah kami terima.' },
        { q: 'Apakah harga sudah termasuk domain dan hosting?', a: 'Tergantung paket yang dipilih — sebagian paket sudah termasuk domain dan hosting tahun pertama, detail lengkap ada di halaman tiap layanan.' },
        { q: 'Apakah saya bisa mengelola konten sendiri setelah website jadi?', a: 'Bisa. Setiap website dilengkapi CMS admin yang mudah dipakai untuk update layanan, blog, dan media tanpa perlu coding.' },
        { q: 'Apakah ada revisi setelah desain awal?', a: 'Ada, jumlah revisi mengikuti ketentuan paket yang dipilih. Detail bisa didiskusikan saat konsultasi.' },
        { q: 'Bagaimana kalau lokasi bisnis saya di luar kota yang tercantum?', a: 'Tetap bisa — proses kerja kami sepenuhnya online, jadi lokasi bisnis di mana pun tidak jadi kendala.' },
      ].map((item) => (
        <details class="rounded-lg border border-charcoal/10 bg-white/40 p-4">
          <summary class="cursor-pointer font-medium text-charcoal">{item.q}</summary>
          <p class="mt-2 text-sm text-charcoal/60">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-brick py-16 text-bone">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-3xl font-semibold">Siap punya website sendiri?</h2>
      <p class="mt-3 text-bone/80">Ceritakan kebutuhan bisnis Anda, kami bantu wujudkan dalam bentuk website.</p>

      {whatsappHref && (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block rounded-full bg-bone px-8 py-3 text-sm font-medium text-brick hover:opacity-90">
          Mulai Konsultasi
        </a>
      )}
    </div>
  </section>
</Layout>

<style>
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<script define:vars={{ exampleSlugs }}>
  const el = document.getElementById('typewriter');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && exampleSlugs.length > 0 && !prefersReducedMotion) {
    let slugIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const current = exampleSlugs[slugIndex];

      if (!deleting) {
        charIndex++;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(tick, 1400);
          return;
        }
      } else {
        charIndex--;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          slugIndex = (slugIndex + 1) % exampleSlugs.length;
        }
      }

      setTimeout(tick, deleting ? 30 : 60);
    }

    tick();
  } else if (el && exampleSlugs.length > 0) {
    el.textContent = exampleSlugs[0];
  }
</script>