---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getPortfolioBySlug, getRelatedPortfolios } from '@/lib/services/portfolio.service';
import { resolveSeo } from '@/lib/seo/resolve-seo';
import { renderRichContent } from '@/lib/tiptap/render';
import { creativeWorkJsonLd } from '@/lib/seo/json-ld';
import { getTechIcon } from '@/lib/tech-icons';

const { slug } = Astro.params;
const portfolio = await getPortfolioBySlug(slug!);

if (!portfolio) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return Astro.redirect('/404');
}

const seo = await resolveSeo('portfolio', portfolio.id, {
  title: portfolio.title,
  description: portfolio.clientName ? `Proyek untuk ${portfolio.clientName}` : portfolio.title,
  ogImage: portfolio.coverImage ?? undefined,
});

const contentHtml = renderRichContent(portfolio.content);
const technologies = (portfolio.technologies as string[]) ?? [];
const related = await getRelatedPortfolios(portfolio.id, portfolio.category, 3);

const jsonLd = creativeWorkJsonLd({
  title: portfolio.title,
  description: seo.description,
  url: Astro.url.href,
  image: portfolio.coverImage ?? undefined,
  dateModified: portfolio.updatedAt,
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={seo.title} description={seo.description} ogImage={seo.ogImage} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <a href="/portfolio" class="inline-flex items-center gap-1.5 text-sm font-medium text-charcoal/50 hover:text-brick">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Kembali ke Portofolio
    </a>

    {portfolio.category && (
      <span class="mt-6 inline-block rounded-full bg-brick/10 px-3 py-1 font-mono text-xs uppercase tracking-wide text-brick">
        {portfolio.category}
      </span>
    )}

    <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-charcoal sm:text-4xl">
      {portfolio.title}
    </h1>

    {portfolio.clientName && (
      <p class="mt-3 text-sm text-charcoal/50">
        Klien: <span class="font-medium text-charcoal/80">{portfolio.clientName}</span>
      </p>
    )}

    {technologies.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {technologies.map((tech) => {
          const iconPath = getTechIcon(tech);
          return (
            <span class="flex items-center gap-1.5 rounded-full bg-charcoal/5 px-3 py-1.5 text-xs text-charcoal/70">
              {iconPath ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d={iconPath} />
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16M6 8l-4 4 4 4m12-8l4 4-4 4" />
                </svg>
              )}
              {tech}
            </span>
          );
        })}
      </div>
    )}

    {portfolio.coverImage && (
      <div class="mt-8 overflow-hidden rounded-xl">
        <img src={portfolio.coverImage} alt={portfolio.title} class="w-full" loading="eager" />
      </div>
    )}

    {contentHtml ? (
      <div class="prose prose-sm mt-10 max-w-none prose-headings:font-display prose-headings:text-charcoal prose-a:text-brick prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg" set:html={contentHtml} />
    ) : (
      <p class="mt-10 text-sm italic text-charcoal/40">Detail konten tidak tersedia.</p>
    )}

    <div class="mt-10 flex flex-col gap-3 border-t border-charcoal/10 pt-8 sm:flex-row">
      {portfolio.projectUrl && (
        <a
          href={portfolio.projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brass px-6 py-3 text-center text-sm font-medium text-ink hover:opacity-90"
        >
          Kunjungi Proyek
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <a
        href="/kontak"
        class="inline-block rounded-full border border-charcoal/20 px-6 py-3 text-center text-sm font-medium text-charcoal hover:border-brick hover:text-brick"
      >
        Diskusikan Proyek Serupa
      </a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="border-t border-charcoal/10 bg-charcoal/5 py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-brick">Proyek Lainnya</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-charcoal">Lihat karya kami yang lain</h2>

        <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-3">
          {related.map((p) => (
            <a href={`/portfolio/${p.slug}`} class="group block">
              {p.coverImage && (
                <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl">
                  <img src={p.coverImage} alt={p.title} class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
                </div>
              )}
              <div class="mt-4">
                {p.category && (
                  <span class="inline-block rounded-full bg-brick/10 px-3 py-1 font-mono text-xs uppercase tracking-wide text-brick">
                    {p.category}
                  </span>
                )}
                <h3 class="mt-2 font-display text-base font-semibold text-charcoal group-hover:text-brick">{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>