---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import { getPortfolioBySlug } from '@/lib/services/portfolio.service';
import { resolveSeo } from '@/lib/seo/resolve-seo';
import { renderRichContent } from '@/lib/tiptap/render';

const { slug } = Astro.params;
const portfolio = await getPortfolioBySlug(slug!);

if (!portfolio) {
  return Astro.redirect('/404');
}

const seo = await resolveSeo('portfolio', portfolio.id, {
  title: portfolio.title,
  description: portfolio.clientName ? `Proyek untuk ${portfolio.clientName}` : portfolio.title,
  ogImage: portfolio.coverImage ?? undefined,
});

const contentHtml = renderRichContent(portfolio.content);
const technologies = (portfolio.technologies as string[]) ?? [];
---

<Layout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    {portfolio.category && (
      <span class="font-mono text-xs uppercase tracking-widest text-brick">{portfolio.category}</span>
    )}

    <h1 class="mt-2 font-display text-3xl font-semibold text-charcoal sm:text-4xl">{portfolio.title}</h1>

    {portfolio.clientName && (
      <p class="mt-3 text-sm text-charcoal/60">Klien: {portfolio.clientName}</p>
    )}

    {portfolio.coverImage && (
      <img src={portfolio.coverImage} alt={portfolio.title} class="mt-8 w-full rounded-lg object-cover" />
    )}

    {technologies.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <span class="rounded-full bg-charcoal/5 px-3 py-1 text-xs text-charcoal/70">{tech}</span>
        ))}
      </div>
    )}

    {contentHtml && (
      <div class="prose prose-sm mt-8 max-w-none" set:html={contentHtml} />
    )}

    {portfolio.projectUrl && (
      <a
        href={portfolio.projectUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-block rounded-full bg-brass px-6 py-3 text-sm font-medium text-ink hover:opacity-90"
      >
        Kunjungi Proyek →
      </a>
    )}
  </article>
</Layout>