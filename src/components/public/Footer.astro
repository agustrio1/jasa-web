---
import { getSettings } from '@/lib/services/settings.service';
import { getAllServices } from '@/lib/services/service.service';

const settings = await getSettings([
  'site_name',
  'site_default_meta_description',
  'social_facebook',
  'social_instagram',
  'social_tiktok',
  'social_whatsapp',
]);

const siteName = settings.site_name || 'Nexaro Studio';
const year = new Date().getFullYear();

const services = await getAllServices();

const cityLinks = Array.from(
  new Map(
    services.flatMap((s) => s.locations?.map((l: any) => [l.city, l.slug]) ?? [])
  )
).slice(0, 8);

const SOCIALS = [
  { key: 'social_facebook', label: 'Facebook', path: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
  { key: 'social_instagram', label: 'Instagram', path: 'M12 8a4 4 0 100 8 4 4 0 000-8zm0 0v0M4 4h16v16H4V4zm12.5 3.5h.01' },
  { key: 'social_tiktok', label: 'TikTok', path: 'M9 12a4 4 0 104 4V4a5 5 0 005 5' },
].filter((s) => settings[s.key]);

const NAV_LINKS = [
  { label: 'Beranda', href: '/' },
  { label: 'Layanan & Paket', href: '/layanan' },
  { label: 'Portofolio Proyek', href: '/portfolio' },
  { label: 'Artikel & Blog', href: '/blog' },
  { label: 'Kontak', href: '/kontak' },
];

const POLICY_LINKS = [
  { label: 'Kebijakan Privasi', href: '/privacy-policy' },
  { label: 'Syarat & Ketentuan', href: '/terms' },
];
---

<footer class="border-t border-brass/20 bg-ink text-bone">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      <div class="md:col-span-1">
        <p class="font-display text-xl font-bold tracking-wide text-bone">{siteName}</p>
        <p class="mt-4 text-sm leading-relaxed text-bone/60">
          {settings.site_default_meta_description || 'Penyedia layanan pengembangan website profesional, cepat, aman, dan berstandar SEO tinggi.'}
        </p>
        <div class="mt-6 flex gap-3">
          {SOCIALS.map((s) => (
            <a
              href={settings[s.key]}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-bone/20 text-bone/70 transition-colors hover:border-brass hover:text-brass"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={s.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brass">Perusahaan</p>
        <ul class="mt-4 space-y-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-bone/70 transition-colors hover:text-brass">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brass">Legalitas</p>
        <ul class="mt-4 space-y-3">
          {POLICY_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-bone/70 transition-colors hover:text-brass">{link.label}</a>
            </li>
          ))}
        </ul>
        <div class="mt-6 rounded border border-brass/20 bg-black/10 p-3">
          <p class="font-mono text-[11px] text-brass/80">Premium Server SLA 99.9%</p>
          <p class="mt-1 text-[10px] text-bone/40">Sistem dipantau 24/7 demi keamanan data Anda.</p>
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brass">Hubungi Kami</p>
        <p class="mt-4 text-sm leading-relaxed text-bone/70">
          Kantor:<br />
          <span class="font-medium text-bone">Kediri, Jawa Timur</span>
        </p>

        {settings.social_whatsapp && (
          <div class="mt-4">
            <span class="block text-xs text-bone/40">Customer Support:</span>
            <a
              href={`https://wa.me/${settings.social_whatsapp.replace(/\D/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-block font-mono text-base font-semibold text-brass hover:underline"
            >
              {settings.social_whatsapp}
            </a>
          </div>
        )}
      </div>
    </div>

    {cityLinks.length > 0 && (
      <div class="mt-12 border-t border-bone/10 pt-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-brass">Kota yang Kami Layani</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {cityLinks.map(([city, slug]) => (
            <a href={`/layanan/${slug}`} class="rounded-full border border-bone/15 px-3 py-1 text-xs text-bone/60 hover:border-brass hover:text-brass">
              {city}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12 flex flex-col justify-between gap-4 border-t border-bone/10 pt-8 text-xs text-bone/40 sm:flex-row">
      <div>© {year} {siteName}. Semua hak cipta dilindungi.</div>
      <div>{siteName}</div>
    </div>
  </div>
</footer>