---
import { getSettings } from '@/lib/services/settings.service';

const settings = await getSettings(['site_name', 'social_whatsapp']);
const siteName = settings.site_name || 'Nexaro Studio';
const whatsapp = settings.social_whatsapp;

const NAV_LINKS = [
  { label: 'Beranda', href: '/' },
  { label: 'Layanan', href: '/layanan' },
  { label: 'Portofolio', href: '/portfolio' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Blog', href: '/blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-bone/10 bg-ink/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brass font-display text-sm font-bold text-ink">
        {siteName.charAt(0)}
      </span>
      <span class="font-display text-lg font-semibold tracking-tight text-white transition-colors group-hover:text-brass">
        {siteName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {NAV_LINKS.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`relative rounded-full px-4 py-2 text-sm font-medium transition-colors ${
              isActive ? 'text-brass' : 'text-bone/70 hover:text-white'
            }`}
          >
            {link.label}
            {isActive && (
              <span class="absolute inset-x-4 -bottom-[17px] h-[2px] rounded-full bg-brass"></span>
            )}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-3">
      {whatsapp && (
        <a
          href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-full bg-brass px-5 py-2.5 text-sm font-semibold text-ink shadow-md shadow-brass/20 transition-all hover:-translate-y-0.5 hover:opacity-90 sm:inline-flex"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.713-1.457L0 24zm6.59-4.846c1.6.95 3.488 1.449 5.412 1.451 5.428 0 9.846-4.415 9.849-9.847a9.77 9.77 0 0 0-2.868-6.963 9.8 9.8 0 0 0-6.964-2.864c-5.43 0-9.85 4.415-9.852 9.849-.001 1.925.501 3.808 1.454 5.409l-.951 3.474 3.562-.934zm11.205-5.385c-.372-.188-2.202-1.086-2.543-1.21-.343-.124-.593-.188-.843.188-.25.374-.967 1.21-1.184 1.459-.219.248-.438.277-.81.09-3.623-1.814-5.024-3.097-6.233-5.174-.313-.537.313-.497.896-1.656.093-.19.047-.355-.023-.497-.072-.143-.593-1.428-.813-1.957-.214-.514-.448-.444-.619-.453-.16-.008-.343-.01-.527-.01-.184 0-.485.069-.739.347-.253.277-.967.944-.967 2.301 0 1.356.987 2.668 1.123 2.852.137.184 1.943 2.967 4.707 4.16.657.284 1.17.453 1.57.58.66.21 1.26.18 1.734.11.53-.08 1.63-.667 1.86-1.282.23-.615.23-1.142.16-1.252-.07-.11-.253-.188-.626-.376z"/>
          </svg>
          Hubungi Kami
        </a>
      )}

      <button
        id="mobile-menu-btn"
        class="rounded-lg p-2 text-bone transition-colors hover:bg-white/5 md:hidden"
        aria-label="Buka menu"
        aria-expanded="false"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="grid grid-rows-[0fr] overflow-hidden border-t border-transparent bg-ink/95 backdrop-blur-md transition-all duration-300 ease-in-out md:hidden"
  >
    <div class="flex min-h-0 flex-col gap-1 px-4 py-3">
      {NAV_LINKS.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`rounded-lg px-3 py-2.5 text-sm font-medium transition-colors ${
              isActive ? 'bg-brass/10 text-brass' : 'text-bone/80 hover:bg-white/5 hover:text-white'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      {whatsapp && (
        <a
          href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 flex items-center justify-center gap-2 rounded-full bg-brass px-4 py-3 text-center text-sm font-semibold text-ink"
        >
          Hubungi Kami
        </a>
      )}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('grid-rows-[1fr]');
    menu?.classList.toggle('grid-rows-[0fr]', isOpen);
    menu?.classList.toggle('grid-rows-[1fr]', !isOpen);
    menu?.classList.toggle('border-t', !isOpen);
    menu?.classList.toggle('border-bone/10', !isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn?.setAttribute('aria-expanded', String(!isOpen));
  });
</script>