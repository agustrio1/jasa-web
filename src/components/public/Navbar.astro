---
import { getSettings } from '@/lib/services/settings.service';

const settings = await getSettings(['site_name', 'social_whatsapp']);
const siteName = settings.site_name || 'Nexaro Studio';
const whatsapp = settings.social_whatsapp;

const NAV_LINKS = [
  { label: 'Beranda', href: '/' },
  { label: 'Layanan', href: '/layanan' },
  { label: 'Portofolio', href: '/portfolio' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-50 border-b border-brass/20 bg-ink">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="font-display text-lg font-semibold tracking-tight text-bone">
      {siteName}
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="text-sm text-bone/80 transition-colors hover:text-brass">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {whatsapp && (
        <a
          href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-full bg-brass px-4 py-2 text-sm font-medium text-ink transition-opacity hover:opacity-90 sm:inline-block"
        >
          Hubungi Kami
        </a>
      )}

      <button id="mobile-menu-btn" class="rounded-md p-2 text-bone md:hidden" aria-label="Buka menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-brass/20 px-4 py-3 md:hidden">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class="rounded-md px-3 py-2 text-sm text-bone/80 hover:bg-brass/10 hover:text-brass">
        {link.label}
      </a>
    ))}
    {whatsapp && (
      <a
        href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 rounded-full bg-brass px-4 py-2 text-center text-sm font-medium text-ink"
      >
        Hubungi Kami
      </a>
    )}
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>