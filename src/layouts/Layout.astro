---
import Seo from '@/components/Seo.astro';
import Navbar from '@/components/public/Navbar.astro';
import Footer from '@/components/public/Footer.astro';
import WhatsappFloat from '@/components/public/WhatsappFloat.astro';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@/styles/global.css';
import secondaryFontsUrl from '@/styles/fonts-secondary.css?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, jsonLd } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} ogImage={ogImage} jsonLd={jsonLd} />
    <link rel="preload" as="style" href={secondaryFontsUrl} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={secondaryFontsUrl} /></noscript>
  </head>
  <body class="font-body text-charcoal">
    <Navbar />
    <slot />
    <Footer />
    <WhatsappFloat />
  </body>
</html>